BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
# Pooled Neon connection (host includes "-pooler") — used by the app at runtime.
DATABASE_URL=
# Direct/unpooled Neon connection (host has no "-pooler") — used only by
# drizzle-kit CLI commands (db:push, db:generate, db:migrate). Get this from
# Neon dashboard > Connection Details > toggle off "Pooled connection".
DATABASE_URL_DIRECT=
