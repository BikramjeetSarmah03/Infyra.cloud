{
  "name": "@infyra/server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@infyra/auth": "workspace:*",
    "@infyra/db": "workspace:*",
    "@infyra/env": "workspace:*",
    "@infyra/schema": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.16",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "^4.12.32",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@infyra/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
